{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "builds": [
    { "src": "api/market_overview.py", "use": "@vercel/python" },
    { "src": "api/top_traded.py", "use": "@vercel/python" },
    { "src": "api/top_volatile.py", "use": "@vercel/python" },
    { "src": "api/top_profitable.py", "use": "@vercel/python" },
    { "src": "api/top_gainers_losers.py", "use": "@vercel/python" },
    { "src": "api/stock_detail.py", "use": "@vercel/python" },
    { "src": "api/daily_picks.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=30, stale-while-revalidate=60" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
